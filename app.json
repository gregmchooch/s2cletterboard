{
  "expo": {
    "name": "AlphaClick: A Tool for S2C Learners",
    "slug": "alphaclick",
    "version": "1.0.0",
    "orientation": "landscape",
    "icon": "./assets/AlphaClickCompliant-icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/AlphaClick-Splash.jpg",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gregmchooch.alphaclick",
      "buildNumber": "1",
        "infoPlist": {
            "ITSAppUsesNonExemptEncryption": false,
            "UIDeviceFamily": [ 1, 2 ],
            "UISupportedInterfaceOrientations": [
                "UIInterfaceOrientationLandscapeLeft",
                "UIInterfaceOrientationLandscapeRight"
            ],
            "UISupportedInterfaceOrientations~ipad": [
                "UIInterfaceOrientationLandscapeLeft",
                "UIInterfaceOrientationLandscapeRight"
            ]
        }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/AlphaClickAndroid-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.gregmchooch.alphaclick",
      "versionCode": 1,
      "edgeToEdgeEnabled": true,
      "orientation": "landscape"
    },
    "web": {
      "favicon": "./assets/AlphaClick-icon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/AlphaClick-Splash.jpg",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "37d79619-dbc3-469f-ac49-d718c5ffd64b"
      }
    }
  }
}
